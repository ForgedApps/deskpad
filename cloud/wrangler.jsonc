{
  // Deskpad cloud: sync API, one Durable Object per tenant, images in R2.
  // See docs/sync-architecture.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deskpad-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "TENANT", "class_name": "TenantDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TenantDO"] }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "deskpad-files" }],
  // Control plane: Better Auth's tables (users, sessions, ...) plus tenant and membership.
  "d1_databases": [{ "binding": "DB", "database_name": "deskpad-accounts", "database_id": "888ce865-f121-4b55-8648-7f52c78f5655" }],
  // The sign-in / device page and, later, the mobile web app. Everything under /api runs the Worker.
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "vars": {
    // "first": only the first account may sign up. "open" for a public launch, "closed" for none.
    "SIGNUP": "first",
    // Optional: the first tenant created takes this id instead of a random one. Leave empty on
    // any server reachable by others: whoever signs up first would inherit that tenant's data.
    "FIRST_TENANT": ""
  },
  // Secrets (wrangler secret put): BETTER_AUTH_SECRET, ADMIN_KEY; optional GOOGLE_CLIENT_ID,
  // GOOGLE_CLIENT_SECRET; DEVICE_TOKENS only for tests. Local dev reads them from .dev.vars.
  "env": {
    "staging": {
      "name": "deskpad-cloud-staging",
      "durable_objects": {
        "bindings": [{ "name": "TENANT", "class_name": "TenantDO" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TenantDO"] }],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "deskpad-files-staging" }],
      "d1_databases": [{ "binding": "DB", "database_name": "deskpad-accounts-staging", "database_id": "REPLACE_WITH_STAGING_D1_ID" }],
      "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
      "vars": { "SIGNUP": "first", "FIRST_TENANT": "" }
    }
  }
}
