{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deskpad",
  "version": "0.1.0",
  "identifier": "com.jgentes.deskpad",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Deskpad",
        "url": "index.html",
        "width": 340,
        "height": 900,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "capture",
        "title": "Capture task",
        "url": "capture.html",
        "width": 560,
        "height": 96,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "center": true
      },
      {
        "label": "tab",
        "title": "Deskpad",
        "url": "tab.html",
        "width": 18,
        "height": 72,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "focus": false
      },
      {
        "label": "alert",
        "title": "Meeting alert",
        "url": "alert.html",
        "width": 800,
        "height": 600,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "transparent": true,
        "shadow": false
      },
      {
        "label": "journal",
        "title": "Deskpad Journal",
        "url": "journal.html",
        "width": 980,
        "height": 720,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/images/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "nsis/installer.nsi"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
